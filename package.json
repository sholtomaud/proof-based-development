{
  "name": "proof-based-development",
  "version": "1.0.0",
  "type": "module",
  "main": "./src/main.ts",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "vite --host",
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "boba": "node scripts/boba.ts",
    "typecheck": "tsc -p .",
    "lint": "oxlint --deny-warnings && node scripts/check-rules.ts && prettier --check \"{src,scripts,tests,e2e}/**/*.{ts,js}\"",
    "format": "prettier --write \"{src,scripts,tests,e2e}/**/*.{ts,js}\"",
    "arch:check": "node scripts/arch-check.ts",
    "test:unit": "node --test \"{src,scripts,tests/lib}/**/*.test.ts\"",
    "test:properties": "node --test \"tests/properties/**/*.test.ts\"",
    "test": "npm run test:unit && npm run test:properties",
    "test:e2e": "playwright test",
    "proof:check": "node scripts/proof-lock.ts && node scripts/proof-changelog.ts",
    "proof:lock": "node scripts/proof-lock.ts --update --from-report public/data/proof-report.json",
    "proof:attest": "node scripts/generate-proof-report.ts --append-changelog",
    "report": "node scripts/generate-proof-report.ts",
    "verify:static": "npm run proof:check && npm run typecheck && npm run lint && npm run arch:check && npm run test:unit && npm run test:properties",
    "verify": "npm run verify:static && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^26.1.1",
    "oxlint": "^1.89.0",
    "postcss": "^8.5.25",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.6"
  },
  "license": "MIT"
}
